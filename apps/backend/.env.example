DATABASE_URL="postgresql://biblioteca:biblioteca@localhost:5433/biblioteca?schema=public"
PORT=3000
# Secreto para firmar los JWT de sesión. Genera uno propio, por ejemplo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Opcional: sin esta key, la búsqueda en Google Books funciona igual pero con
# una cuota más baja de peticiones por día. Se consigue en Google Cloud Console
# habilitando la "Books API".
GOOGLE_BOOKS_API_KEY=
